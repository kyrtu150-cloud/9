# ─── База данных ───────────────────────────────────────────────────────
# Для прототипа используется SQLite. Файл создаётся автоматически.
DATABASE_URL="file:./dev.db"

# ─── NextAuth ──────────────────────────────────────────────────────────
# Сгенерируй секрет: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_ME"
NEXTAUTH_URL="http://localhost:3000"

# ─── OpenRouter (Nano Banana = google/gemini-2.5-flash-image) ──────────
# Получить ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash-image"

# ─── Яндекс OAuth ──────────────────────────────────────────────────────
# Создать приложение: https://oauth.yandex.ru/client/new
# Redirect URI: http://localhost:3000/api/auth/callback/yandex
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# ─── ВКонтакте OAuth ───────────────────────────────────────────────────
# Создать приложение: https://dev.vk.com/admin/apps
# Redirect URI: http://localhost:3000/api/auth/callback/vk
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""

# ─── Email (для magic-link и подтверждений) ────────────────────────────
# Любой SMTP. Пример для Яндекс Почты:
EMAIL_SERVER_HOST="smtp.yandex.ru"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="JOOZ.ai Studio <noreply@jooz.ai>"
